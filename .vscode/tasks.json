{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "restore",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore",
        "ClutterFlock.sln"
      ]
    },
    {
      "label": "build (Debug)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "ClutterFlock.sln",
        "-c",
        "Debug"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build (Release)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "ClutterFlock.sln",
        "-c",
        "Release"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test with coverage",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile",
        "-File",
        "scripts/test-integration.ps1"
      ],
      "group": "test",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "publish (Release, win-x64)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "ClutterFlock.csproj",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "true"
      ]
    }
  ]
}
